# --- SERVEUR ---
PORT=5000
NODE_ENV=development

# --- BASE DE DONNÉES (Supabase Postgres) ---
# Option A (recommandée) : coller directement la "Connection string" Supabase
# Project Settings > Database > Connection string > URI (mode "Transaction" ou "Session")
# Exemple : postgresql://postgres.xxxxxxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Option B : variables séparées (utilisées seulement si DATABASE_URL est vide).
# Si le mot de passe contient des caractères spéciaux (@, #, etc.), entourez-le
# de guillemets, sinon dotenv risque de le tronquer.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# SSL requis par Supabase (laisser à true). Ne mettre à false qu'en local sans SSL.
DB_SSL=true
# Ne mettre à false que si vous obtenez une erreur "self signed certificate in certificate chain"
DB_SSL_REJECT_UNAUTHORIZED=true

# --- AUTHENTIFICATION ---
# Générer une valeur aléatoire forte, ex: openssl rand -hex 32
JWT_SECRET=

# --- CLOUDINARY (stockage des images produits) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- EMAIL (formulaire de contact, via Gmail) ---
# Compte Gmail qui envoie réellement les emails (nécessite un mot de passe
# d'application Gmail, pas le mot de passe du compte) :
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# Destinataire(s) des messages du formulaire de contact (séparés par une virgule).
# Si vide, retombe sur EMAIL_USER.
EMAIL_TO=
